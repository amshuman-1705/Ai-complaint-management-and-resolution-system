{
  "name": "ai-multi-org-backend",
  "version": "1.0.0",
  "description": "Production-Grade AI-Based Multi-Organization Complaint Classification and Resolution System Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && prisma db push --accept-data-loss && tsc",
    "start": "node dist/server.js",
    "dev": "node dist/server.js",
    "db:push": "npx prisma db push",
    "db:seed": "node dist/seed.js",
    "test": "node dist/tests/run-tests.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "prisma": "^5.10.0",
    "typescript": "^5.3.3"
  }
}
